# ── Supabase (REQUIRED) ──
# Create a project at https://supabase.com, then run the migration
# from supabase/migrations/001_schema.sql in the SQL editor.
SUPABASE_URL=your-project.supabase.co
SUPABASE_SERVICE_KEY=service_role_key_here
SUPABASE_ANON_KEY=anon_key_here

# ── Cameras ──
# CAMERAS ARE MANAGED FROM THE APP. Add/edit them in the Flutter app,
# and the backend picks them up automatically from Supabase DB.
# The RTSP_URLS env var below is a fallback if DB is unreachable.
# Format: alias1|rtsp://user:pass@host:554/stream1,alias2|rtsp://...
# RTSP_URLS="FrontDoor|rtsp://admin:pass@192.168.1.10:554/stream1"
DETECTION_TARGETS="person,car,cat,dog"
CONFIDENCE_THRESHOLD=0.5
COOLDOWN_SECONDS=60

# ── Telegram (optional — debug alerts for admin) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Firebase Cloud Messaging (optional — customer push) ──
# Base64-encoded Firebase service account JSON
FCM_CREDENTIALS=

# ── Cloudflare Tunnel (optional — exposes API over internet) ──
# Get a tunnel token from Cloudflare Zero Trust dashboard
TUNNEL_TOKEN=

# ── Logging ──
LOG_LEVEL=INFO
