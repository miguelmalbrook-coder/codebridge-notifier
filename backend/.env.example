# SUPABASE_URL=your-project.supabase.co
# SUPABASE_SERVICE_KEY=service_role_key_here
# SUPABASE_ANON_KEY=anon_key_here
# SUPABASE_JWT_SECRET=jwt_secret_here

# Camera config — comma-separated if multiple cameras
# Format: alias1|rtsp://user:pass@host:554/stream1,alias2|rtsp://user:pass@host:554/stream2
RTSP_URLS="FrontDoor|rtsp://admin:pass@192.168.1.10:554/stream1"
DETECTION_TARGETS="person,car,cat,dog"
CONFIDENCE_THRESHOLD=0.5
COOLDOWN_SECONDS=60

# Telegram (optional — debug alerts for admin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Firebase Cloud Messaging (optional — customer push notifications)
# Base64-encoded Firebase service account JSON
FCM_CREDENTIALS=

# Logging
LOG_LEVEL=INFO
